# Copy this file to `.env` and fill in your key.
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
# Paste it after the "=" with no quotes and no spaces, e.g.
#   ANTHROPIC_API_KEY=sk-ant-api03-abc123...
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. The project runs with zero external API keys:
# OpenStreetMap (Nominatim + Overpass) and Open-Meteo are free and key-less.
# ---------------------------------------------------------------------------

# Nominatim's usage policy REQUIRES a real contact address in the User-Agent.
# Without one you will eventually be rate-limited or blocked. Put your email here.
NT_CONTACT_EMAIL=you@example.com

# Model + reasoning effort. Leave these alone unless you know why you're changing them.
NT_MODEL=claude-opus-5
NT_RESEARCH_EFFORT=high
NT_ASSEMBLY_EFFORT=medium

# Hard ceiling on agent tool-calling turns, so a runaway loop can't drain your credits.
NT_MAX_TURNS=30

# Where the HTTP response cache lives.
NT_CACHE_PATH=data/http_cache.sqlite

# Set to 1 to bypass the cache entirely (useful when debugging a stale response).
NT_CACHE_DISABLED=0
